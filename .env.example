# ---- Trading mode: NEVER set to "live" without completing the go-live checklist ----
TRADING_MODE=paper

# ---- Kafka (Redpanda) ----
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
KAFKA_CLIENT_ID=trading-platform

# ---- Hyperliquid ----
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
HYPERLIQUID_REST_URL=https://api.hyperliquid.xyz/info
HYPERLIQUID_SYMBOLS=BTC,ETH,SOL
HYPERLIQUID_CANDLE_INTERVALS=1m,5m,15m,1h
HYPERLIQUID_ORDERBOOK_DEPTH=20

# ---- Storage ----
TIMESCALE_DSN=postgresql://trader:trader@localhost:5432/marketdata
REDIS_URL=redis://localhost:6379/0

# ---- Paper broker ----
PAPER_STARTING_EQUITY=10000
PAPER_TAKER_FEE_BPS=4.5
PAPER_SLIPPAGE_BPS=1.0

# ---- Risk limits ----
RISK_MAX_POSITION_NOTIONAL=2500
RISK_MAX_PORTFOLIO_LEVERAGE=3.0
RISK_MAX_OPEN_POSITIONS=3
RISK_DAILY_LOSS_LIMIT_PCT=3.0
RISK_RISK_PER_TRADE_PCT=1.0
RISK_MIN_CONFIDENCE=0.55

# ---- Analyst calibration ----
ANALYST_FULL_CONVICTION_SCORE=0.45
ANALYST_MIN_ABS_SCORE=0.15
ANALYST_SIGNAL_TTL_S=90

# ---- Decision engine ----
DECISION_PASSTHROUGH_AGENT=market_analyst
DECISION_MIN_CONFIDENCE=0.55
DECISION_COOLDOWN_S=60

# ---- Extra risk guards ----
RISK_MIN_ORDER_NOTIONAL=10
RISK_MIN_STOP_DISTANCE_PCT=0.15
RISK_DEFAULT_STOP_DISTANCE_PCT=1.5

# ---- Ingestion ----
HYPERLIQUID_PUBLISH_UNCLOSED_CANDLES=false
HYPERLIQUID_WS_RECEIVE_TIMEOUT_S=90

# ---- Persistence (Phase 3) ----
PERSISTENCE_ENABLED=true

# ---- Position monitor ----
MONITOR_DEFAULT_TRAILING_STOP_PCT=
MONITOR_RECONCILE_ADOPTS_UNGUARDED=true

# ---- Trailing stop attached to new orders ----
RISK_TRAILING_STOP_PCT=

# ---- Learning / adaptive trust ----
LEARNING_MIN_SAMPLES_FOR_WEIGHT=30
LEARNING_SCORE_WINDOW=200
LEARNING_MIN_WEIGHT=0.25
LEARNING_MAX_WEIGHT=2.0
LEARNING_ATTRIBUTE_DEGRADED_SIGNALS=false

# ---- Market data recording (Phase 5) ----
# Order book depth and open interest have NO historical endpoint on Hyperliquid.
# A gap in the recorder is a permanent gap in the research data.
RECORDING_ORDERBOOK_INTERVAL_S=5.0
RECORDING_PERP_METRICS_INTERVAL_S=60.0
RECORDING_STORED_BOOK_LEVELS=10
RECORDING_BATCH_SIZE=200
RECORDING_FLUSH_INTERVAL_S=10.0
RECORDING_MAX_RETRY_BUFFER=50000
